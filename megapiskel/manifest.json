{
  "manifest_version": 3,
  "name": "MegaPiskel",
  "version": "1.4",
  "description": "Piskel-Sprites als C-Code für die MEGACARD exportieren (BITMAP_HORIZONTAL/VERTIKAL) und Bitmaps aus C-Code importieren",
  "content_scripts": [
    {
      "matches": ["*://www.piskelapp.com/*", "*://piskelapp.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.piskelapp.com/*", "*://piskelapp.com/*"],
      "js": ["content-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
